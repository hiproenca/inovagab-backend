{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Erro padrão da API",
  "type": "object",
  "properties": {
    "timestamp": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "integer",
      "minimum": 400,
      "maximum": 599
    },
    "error": {
      "type": "string",
      "minLength": 1
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "path": {
      "type": "string",
      "pattern": "^/api/"
    }
  },
  "required": [
    "timestamp",
    "status",
    "error",
    "message",
    "path"
  ],
  "additionalProperties": false
}
