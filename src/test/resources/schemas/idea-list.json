{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Lista de ideias",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "title": {
        "type": "string",
        "minLength": 1
      },
      "description": {
        "type": [
          "string",
          "null"
        ]
      },
      "status": {
        "type": "string",
        "enum": [
          "PENDING",
          "APPROVED",
          "REJECTED"
        ]
      },
      "authorId": {
        "type": "string",
        "minLength": 1
      },
      "strategyId": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "required": [
      "id",
      "title",
      "description",
      "status",
      "authorId",
      "strategyId"
    ],
    "additionalProperties": false
  }
}
